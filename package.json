{
  "name": "nexus-terminal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "web:dev": "vite",
    "web:build": "tsc && vite build",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format": "prettier --write src && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "test": "vitest run && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:web": "vitest run",
    "preview": "vite preview",
    "licenses:generate": "node scripts/third-party-licenses.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "~2.8.4",
    "@tauri-apps/plugin-log": "~2.10.2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "i18next": "^27.2.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^18.0.3",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.0.16",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.23.0"
}
